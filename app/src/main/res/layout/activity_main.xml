<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingVertical="16dp"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/btnStats"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:contentDescription="@string/stadistics"
        app:tint="@color/color_on_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/app_title_size"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnStats"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintBottom_toBottomOf="@id/btnStats" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="@string/configuration"
        app:tint="@color/color_on_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintBottom_toTopOf="@id/tvTimerDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFocus"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_focus"
            android:textColor="@color/color_on_surface"
            android:checked="true"
            app:chipBackgroundColor="@color/color_surface" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBreak"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_break"
            android:textColor="@color/color_on_surface"
            app:chipBackgroundColor="@color/color_surface" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRest"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_rest"
            android:textColor="@color/color_on_surface"
            app:chipBackgroundColor="@color/color_surface" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvTimerDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/timer_text_size"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/chipGroupMode"
        app:layout_constraintBottom_toTopOf="@id/btnStartStop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/sessionDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="20dp"
        app:layout_constraintTop_toUpOf="@id/btnStartStop"
        app:layout_constraintTop_toBottomOf="@id/tvTimerDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartStop"
        android:layout_width="@dimen/btn_primary_width"
        android:layout_height="@dimen/btn_primary_height"
        android:text="@string/btn_start"
        android:textSize="@dimen/btn_text_size"
        android:textColor="@color/color_on_surface"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="@dimen/btn_corner_radius"
        app:layout_constraintTop_toBottomOf="@id/tvTimerDisplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>